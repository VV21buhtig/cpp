#version 450
// demo-5b bright: HDR -> половина с мягким порогом (сглаживает Kawase дальше).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D srcImg;
layout(set = 0, binding = 1, rgba16f) writeonly uniform image2D dstImg;

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dsz = imageSize(dstImg);
    if (t.x >= dsz.x || t.y >= dsz.y) return;
    vec2 uv = (vec2(t) + 0.5) / vec2(dsz);
    vec3 c = texture(srcImg, uv).rgb;
    float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float k = smoothstep(1.0, 1.6, lum); // мягкое колено вместо жёсткого >1
    imageStore(dstImg, t, vec4(c * k, 1.0));
}
