// demo-6 SSAO: depth-only 8 тапов (рецепт книги Ch10/04: линеаризация + отражение
// от хэш-плоскости + falloff). Выход R16F, небо (d=1) всегда 1.0.
#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D depthTex; // D32 копия, nearest
layout(set = 0, binding = 1, r16f) uniform writeonly image2D ssaoOut;

layout(push_constant) uniform Push {
    vec4 res;    // w, h, 1/w, 1/h
    vec4 params; // near, far, radiusWorld, distScale
} pc;

const vec3 OFFS[8] = vec3[8](
    vec3(-0.5, -0.5, -0.5), vec3(0.5, -0.5, -0.5),
    vec3(-0.5, 0.5, -0.5), vec3(0.5, 0.5, -0.5),
    vec3(-0.5, -0.5, 0.5), vec3(0.5, -0.5, 0.5),
    vec3(-0.5, 0.5, 0.5), vec3(0.5, 0.5, 0.5));

float linZ(float d) { return (pc.params.x * pc.params.y) / (pc.params.y - d * (pc.params.y - pc.params.x)); }
float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.res.x) || px.y >= int(pc.res.y)) return;
    vec2 uv = (vec2(px) + 0.5) * pc.res.zw;
    float d = texelFetch(depthTex, px, 0).r;
    if (d >= 1.0) { imageStore(ssaoOut, px, vec4(1.0)); return; } // небо/даль
    float Z = linZ(d);
    // Случайная плоскость из хэша пикселя (вместо rotation-текстуры книги).
    float a = hash12(vec2(px)) * 6.2831853;
    vec3 plane = normalize(vec3(cos(a), sin(a), hash12(vec2(px).yx + 7.3) * 2.0 - 1.0));
    // Радиус в UV: пикселей на единицу мира (по вертикали, fov 70) * радиус / глубина.
    float pxPerUnit = (pc.res.y / (2.0 * 0.7002)) / max(Z, 0.5);
    vec2 uvStep = pc.params.z * pxPerUnit * pc.res.zw;
    float att = 0.0;
    for (int i = 0; i < 8; i++) {
        vec3 rs = reflect(OFFS[i], plane);
        float zS = linZ(textureLod(depthTex, uv + uvStep * rs.xy, 0).r);
        float dist = max(zS - Z, 0.0) / pc.params.w;
        float occl = 15.0 * max(dist * (2.0 - dist), 0.0);
        att += 1.0 / (1.0 + occl * occl);
    }
    att = clamp(att * att / 64.0 + 0.45, 0.0, 1.0);
    imageStore(ssaoOut, px, vec4(att));
}
