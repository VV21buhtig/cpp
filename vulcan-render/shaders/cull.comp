#version 450
// demo-3c cull (Ch11-рецепт): 1 поток = 1 чанк (64 чанка = 1 группа).
// AABB чанка против 6 плоскостей (p-вершина); видимые — в vis[] + indirect.
// firstInstance = chunk*QUADBIAS + quadOff (id чанка в старших битах —
// gl_DrawID в этом glslang нет). QUADBIAS > квадов на чанк (проверка на CPU).
layout(local_size_x = 64) in;

struct Meta { uint quadOff; uint quadCount; vec2 origin; };
layout(set = 0, binding = 0) readonly buffer MetaB { Meta metas[]; };
layout(set = 0, binding = 1) buffer VisB { uint vis[]; };
struct Draw { uint vCount; uint instCount; uint firstVtx; uint firstInst; };
layout(set = 0, binding = 2) buffer IndB { uint count; uint pad[3]; Draw cmds[]; };

layout(push_constant) uniform P { vec4 planes[6]; } pc;

void main() {
    uint idx = gl_LocalInvocationID.x;
    if (idx >= 64u) return;
    vec2 o = metas[idx].origin;
    vec3 bmin = vec3(o.x, 0.0, o.y);
    vec3 bmax = vec3(o.x + 16.0, 64.0, o.y + 16.0);
    for (int i = 0; i < 6; i++) {
        vec3 n = pc.planes[i].xyz;
        // p-вершина: дальний угол AABB по нормали плоскости
        vec3 p = vec3(n.x >= 0.0 ? bmax.x : bmin.x,
                      n.y >= 0.0 ? bmax.y : bmin.y,
                      n.z >= 0.0 ? bmax.z : bmin.z);
        if (dot(n, p) + pc.planes[i].w < 0.0) return; // целиком снаружи
    }
    uint s = atomicAdd(count, 1u);
    vis[s] = idx; // отладка/запас; VS чанк берёт из firstInstance, не отсюда
    cmds[s] = Draw(6u, metas[idx].quadCount, 0u, idx * 1048576u + metas[idx].quadOff);
}
