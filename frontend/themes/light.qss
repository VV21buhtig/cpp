/* VS Code Light (light_vs.json + дефолты). Только текст и рамки, без картинок. */
QMainWindow, QWidget { background: #FFFFFF; color: #000000; }
QMenuBar { background: #DDDDDD; color: #000000; }
QMenuBar::item:selected { background: #C4C4C4; }
QMenu { background: #F3F3F3; color: #000000; border: 1px solid #CCCCCC; }
QMenu::item:selected { background: #C4C4C4; }
QToolBar { background: #DDDDDD; border: none; border-bottom: 1px solid #CCCCCC; spacing: 2px; }
QToolBar QToolButton { background: transparent; color: #000000; padding: 4px 8px; }
QToolBar QToolButton:checked { background: #C4C4C4; color: black; }
QDockWidget { color: #000000; }
QDockWidget::title { background: #F3F3F3; padding: 4px; border-bottom: 1px solid #CCCCCC; }
QTabWidget::pane { border: 1px solid #CCCCCC; background: #FFFFFF; }
QTabBar::tab { background: #ECECEC; color: #000000; border: 1px solid #CCCCCC; padding: 4px 10px; }
QTabBar::tab:selected { background: #FFFFFF; }
QTreeView, QListView, QTextEdit, QLineEdit { background: #FFFFFF; color: #000000; border: 1px solid #CCCCCC; }
QTreeView::item:selected, QListView::item:selected { background: #007ACC; color: white; }
QGroupBox { border: 1px solid #CCCCCC; margin-top: 14px; color: #000000; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; }
QDoubleSpinBox, QComboBox { background: #FFFFFF; color: #000000; border: 1px solid #CCCCCC; padding: 2px; }
QPushButton { background: #007ACC; color: white; border: none; padding: 5px 14px; }
QPushButton:flat { background: transparent; color: #000000; }
QSlider::groove:horizontal { background: #CCCCCC; height: 4px; }
QSlider::handle:horizontal { background: #007ACC; width: 12px; margin: -5px 0; }
QScrollBar:vertical { background: #F3F3F3; width: 12px; }
QScrollBar::handle:vertical { background: #CCCCCC; min-height: 20px; }
QStatusBar { background: #007ACC; color: white; }
QStatusBar::item { border: none; }
QSplitter::handle { background: #CCCCCC; }
