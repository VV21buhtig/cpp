<rml>
<head>
<title>Pause</title>
<link type="text/css" href="rml-base.rcss"/>
<link type="text/css" href="mc.rcss"/>
<link type="text/css" href="pause.rcss"/>
</head>
<body>
<div id="shade"></div>
<div id="menu">
<h1>Game menu</h1>
<button id="back">Back to Game</button>
<button id="opt">Options...</button>
<div id="opts">
<div class="srow"><span>FOV</span><input type="range" id="s_fov" min="30" max="110" step="1"/><span class="val" id="v_fov"></span></div>
<div class="srow"><span>Gamma</span><input type="range" id="s_gamma" min="0.5" max="4" step="0.1"/><span class="val" id="v_gamma"></span></div>
<div class="srow"><span>Fog</span><input type="range" id="s_fog" min="50" max="500" step="5"/><span class="val" id="v_fog"></span></div>
<div class="brow"><button id="b_dist">Render Distance</button><button id="b_filter">Filtering</button></div>
<div class="brow"><button id="b_vsync">VSync</button><button id="b_res">Resolution</button></div>
<div class="brow"><button id="b_fs">Fullscreen</button><button id="b_aa">AA</button></div>
<div class="brow"><button id="b_gscale">GUI Scale</button><button id="done">Done</button></div>
</div>
<button id="quit">Save and Quit to Title</button>
</div>
</body>
</rml>
