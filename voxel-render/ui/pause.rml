<rml>
<head>
<title>Pause</title>
<link type="text/css" href="pause.rcss"/>
</head>
<body>
<div id="shade"></div>
<div id="menu">
<h1>Game menu</h1>
<button id="back">Back to Game</button>
<button id="opt">Options...</button>
<div id="opts">
<div class="srow"><span>FOV</span><input type="range" id="s_fov" min="30" max="110" step="1"/></div>
<div class="srow"><span>Gamma</span><input type="range" id="s_gamma" min="0.5" max="4" step="0.1"/></div>
<div class="srow"><span>Fog</span><input type="range" id="s_fog" min="50" max="500" step="5"/></div>
<button id="done">Done</button>
</div>
<button id="quit">Save and Quit to Title</button>
</div>
</body>
</rml>
