/* Пауза: поверх общих mc-стилей — затемнение, центрирование, скрытые опции. */
#shade {
    position: absolute;
    left: 0dp; top: 0dp;
    width: 100%; height: 100%;
    background: rgba(0, 0, 0, 153);
}
#menu {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 460dp;
    margin-left: -220dp;
    transform: translateY(-50%);
    max-height: 94%;
    overflow-y: auto;
    text-align: center;
}
#opts { display: none; }
