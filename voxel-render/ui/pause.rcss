/* Пауза: поверх общих mc-стилей — затемнение, центрирование, скрытые опции. */
#shade {
    position: absolute;
    left: 0dp; top: 0dp;
    width: 100%; height: 100%;
    background: rgba(0, 0, 0, 153);
}
#menu {
    position: relative; /* выше #shade: absolute без z-index красится поверх статики и жрёт клики */
    width: 460dp;
    max-height: 94%;
    overflow-y: auto;
    text-align: center;
}
#opts { display: none; }
