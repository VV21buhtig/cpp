/* Пауза в духе MC: каменные кнопки, тень текста, затемнение мира. */
body {
    font-family: Monocraft;
    font-size: 20px;
    color: #ffffff;
}
#shade {
    position: absolute;
    left: 0px; top: 0px;
    width: 100%; height: 100%;
    background: rgba(0, 0, 0, 153);
}
#menu {
    position: absolute;
    left: 0px; top: 15%;
    width: 100%;
    text-align: center;
}
h1 {
    font-size: 26px;
    color: #c8c8c8;
    font-effect: shadow(2px 2px #3f3f3f);
    text-align: center;
}
button {
    display: block;
    width: 400px; height: 36px;
    margin-top: 4px; margin-bottom: 4px;
    margin-left: auto; margin-right: auto;
    background: #969696;
    color: #ffffff;
    border-width: 2px;
    border-color: #000000;
    font-effect: shadow(2px 2px #3f3f3f);
    text-align: center;
}
button:hover {
    background: #a0a8e1;
    color: #ffffa0;
}
#opts { display: none; }
.srow {
    width: 400px;
    margin-left: auto; margin-right: auto;
}
.srow span {
    display: inline-block;
    width: 110px;
    text-align: left;
}
.srow input { width: 280px; }
