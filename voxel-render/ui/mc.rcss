/* Общие MC-стили RML-документов: кнопки, заголовки, строки, слайдеры. */
body {
    font-family: Monocraft;
    font-size: 20dp;
    color: #ffffff;
    width: 100%;
    height: 100%;
}
h1 {
    display: block;
    font-size: 26dp;
    color: #c8c8c8;
    font-effect: shadow(2dp 2dp #3f3f3f);
    text-align: center;
}
button {
    display: block;
    box-sizing: border-box;
    font-size: 18dp;
    width: 400dp; height: 36dp;
    margin-top: 4dp; margin-bottom: 4dp;
    margin-left: auto; margin-right: auto;
    background: #969696;
    color: #ffffff;
    border-width: 2dp;
    border-color: #000000;
    font-effect: shadow(2dp 2dp #3f3f3f);
    text-align: center;
}
button:hover {
    background: #a0a8e1;
    color: #ffffa0;
}
/* Range-слайдеры: внутри slidertrack/sliderbar (без размеров схлопываются). */
.srow {
    display: block;
    width: 400dp;
    margin-left: auto; margin-right: auto;
}
.srow span {
    display: inline-block;
    vertical-align: middle;
    width: 70dp;
    text-align: left;
}
.srow .val {
    display: inline-block;
    vertical-align: middle;
    width: 90dp;
    text-align: right;
    color: #c8c8c8;
}
/* Пары кнопок в ряд как в MC (влезает без скролла). */
.brow {
    display: block;
    width: 400dp;
    margin-left: auto; margin-right: auto;
}
.brow button {
    display: inline-block;
    vertical-align: top;
    width: 196dp;
    margin-left: 0dp; margin-right: 0dp;
}
.brow button:first-child { margin-right: 8dp; }
input.range {
    display: inline-block;
    vertical-align: middle;
    width: 220dp;
    height: 28dp;
}
input.range slidertrack {
    height: 10dp;
    margin-top: 9dp;
    background: #2e2e2e;
    border-width: 2dp;
    border-color: #000000;
}
input.range sliderbar {
    width: 18dp;
    height: 24dp;
    margin-top: 2dp;
    background: #c8c8c8;
    border-width: 2dp;
    border-color: #000000;
}
input.range sliderbar:hover { background: #ececec; }
input.range sliderbar:active { background: #ffffa0; }
input.range sliderarrowdec, input.range sliderarrowinc { display: none; }
