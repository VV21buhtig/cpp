<rml>
<head>
<title>Inventory</title>
<link type="text/css" href="rml-base.rcss"/>
<link type="text/css" href="mc.rcss"/>
<link type="text/css" href="inv.rcss"/>
</head>
<body>
<div id="invpanel">
<h1>Inventory</h1>
<div class="invrow"><div class="islot" id="ss0"><img id="si0"/><span id="sc0"></span></div><div class="islot" id="ss1"><img id="si1"/><span id="sc1"></span></div><div class="islot" id="ss2"><img id="si2"/><span id="sc2"></span></div><div class="islot" id="ss3"><img id="si3"/><span id="sc3"></span></div><div class="islot" id="ss4"><img id="si4"/><span id="sc4"></span></div><div class="islot" id="ss5"><img id="si5"/><span id="sc5"></span></div><div class="islot" id="ss6"><img id="si6"/><span id="sc6"></span></div><div class="islot" id="ss7"><img id="si7"/><span id="sc7"></span></div><div class="islot" id="ss8"><img id="si8"/><span id="sc8"></span></div></div>
<div class="invrow"><div class="islot" id="ss9"><img id="si9"/><span id="sc9"></span></div><div class="islot" id="ss10"><img id="si10"/><span id="sc10"></span></div><div class="islot" id="ss11"><img id="si11"/><span id="sc11"></span></div><div class="islot" id="ss12"><img id="si12"/><span id="sc12"></span></div><div class="islot" id="ss13"><img id="si13"/><span id="sc13"></span></div><div class="islot" id="ss14"><img id="si14"/><span id="sc14"></span></div><div class="islot" id="ss15"><img id="si15"/><span id="sc15"></span></div><div class="islot" id="ss16"><img id="si16"/><span id="sc16"></span></div><div class="islot" id="ss17"><img id="si17"/><span id="sc17"></span></div></div>
<div class="invrow"><div class="islot" id="ss18"><img id="si18"/><span id="sc18"></span></div><div class="islot" id="ss19"><img id="si19"/><span id="sc19"></span></div><div class="islot" id="ss20"><img id="si20"/><span id="sc20"></span></div><div class="islot" id="ss21"><img id="si21"/><span id="sc21"></span></div><div class="islot" id="ss22"><img id="si22"/><span id="sc22"></span></div><div class="islot" id="ss23"><img id="si23"/><span id="sc23"></span></div><div class="islot" id="ss24"><img id="si24"/><span id="sc24"></span></div><div class="islot" id="ss25"><img id="si25"/><span id="sc25"></span></div><div class="islot" id="ss26"><img id="si26"/><span id="sc26"></span></div></div>
<div class="invrow"><div class="islot" id="hh0"><img id="hi0h"/><span id="hc0"></span></div><div class="islot" id="hh1"><img id="hi1h"/><span id="hc1"></span></div><div class="islot" id="hh2"><img id="hi2h"/><span id="hc2"></span></div><div class="islot" id="hh3"><img id="hi3h"/><span id="hc3"></span></div><div class="islot" id="hh4"><img id="hi4h"/><span id="hc4"></span></div><div class="islot" id="hh5"><img id="hi5h"/><span id="hc5"></span></div><div class="islot" id="hh6"><img id="hi6h"/><span id="hc6"></span></div><div class="islot" id="hh7"><img id="hi7h"/><span id="hc7"></span></div><div class="islot" id="hh8"><img id="hi8h"/><span id="hc8"></span></div></div>
<div id="invhint">Drag stacks between storage and hotbar.</div>
</div>
<img id="carry"/>
</body>
</rml>
