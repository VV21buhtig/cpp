/* Создание мира. */
#cmenu {
    position: absolute;
    left: 50%;
    top: 10%;
    width: 460dp;
    margin-left: -220dp;
    text-align: center;
}
.lab {
    display: block;
    width: 400dp;
    margin-left: auto; margin-right: auto;
    color: #c8c8c8;
    text-align: left;
}
#c_name {
    display: block;
    width: 400dp;
    margin-left: auto; margin-right: auto;
}
#seedrow {
    display: block;
    width: 400dp;
    margin-left: auto; margin-right: auto;
}
#seedrow input {
    display: inline-block;
    vertical-align: middle;
    width: 220dp;
}
#seedrow button {
    display: inline-block;
    vertical-align: middle;
    width: 170dp;
}
input.text {
    background: #000000;
    color: #ffffff;
    border-width: 2dp;
    border-color: #808080;
}
