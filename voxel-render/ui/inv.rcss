/* Survival-инвентарь: 27 хранилище + 9 хотбар, counts влияют на стройку.
   Панель светло-серая как в MC, слоты вдавленные. */
#invpanel {
    position: absolute;
    left: 50%;
    top: 6%;
    width: 480dp;
    margin-left: -240dp;
    text-align: center;
    background: #c6c6c6;
    border-width: 2dp;
    border-color: #000000;
    padding-top: 6dp;
    padding-bottom: 6dp;
    color: #ffffff;
}
#invpanel h1 {
    color: #404040;
}
.invrow {
    display: block;
    text-align: center;
}
.islot {
    display: inline-block;
    vertical-align: top;
    position: relative;
    box-sizing: border-box;
    width: 44dp;
    height: 44dp;
    margin: 2dp;
    padding-top: 2dp;
    background: #8b8b8b;
    border-width: 2dp;
    border-color: #373737;
    text-align: center;
}
.islot img {
    width: 32dp;
    height: 32dp;
}
#invpanel h1 {
    color: #404040;
    font-effect: none;
}
.islot span {
    position: absolute;
    right: 2dp;
    bottom: 0dp;
    font-size: 14dp;
    color: #ffffff;
    font-effect: shadow(1dp 1dp #3f3f3f);
}
.islot:hover { border-color: #ffffff; }
.islot.lift { border-color: #ffffa0; }
#invhint {
    color: #404040;
    text-align: center;
}
#carry {
    position: absolute;
    width: 32dp;
    height: 32dp;
    display: none;
}
